rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Channels collection - Publicly accessible for seamless global sync
    match /channels/{channelId} {
      allow read, write: if true;
    }

    // App Configs collection - Configuration details like performance advisory alert
    match /app_configs/{configId} {
      allow read, write: if true;
    }
  }
}
